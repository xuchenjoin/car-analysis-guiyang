<div id="banner">
    <div class="widthLimit">
        <a id="logoUrl" href="http://www.hwclouds.com">
            <img id="logo" src="./images/logo_zh-cn.png">
        </a>
        <span id="bannerQuickLink">
            <a  class="links" href="http://www.hwclouds.com"><%= i18n.console_term_homePage_label %></a>
        </span>
    </div>
</div>

<div id="content">
    <div class="widthLimit">
        <ul class="browserContent" id="oldBrowser">
            <li id="oldBrowserText">
                <p class="browserInfo"><img id="face"
                                            src="images/face.png"/><%= i18n.console_term_oldBrowserVersion_label %></p>
                <p class="browserTitle"><%= i18n.console_term_pleaseUpdate_label %></p>
                <p class="browserTitle" id="hotLine"><%= i18n.console_term_questionToTotLine_label %>
                    <span> 4000-955-988</span></p>
            </li>
        </ul>
    </div>
    <div class="widthLimit">
        <ul class="browserContent">
            <li>
                <div class="browserName">
                    <img src="images/chrome.png">

                    <p>Chrome 31+</p>
                    <a class="browserLink"
                       href="https://www.google.com/chrome/"><%= i18n.console_term_download_label %></a>
                </div>
            </li>
            <li>
                <div class="browserName">
                    <img src="images/ie.png">

                    <p>IE 9+</p>
                    <a class="browserLink"
                       href="http://www.microsoft.com/zh-cn/download/internet-explorer-9-details.aspx"><%= i18n.console_term_download_label %></a>
                </div>
            </li>
            <li>
                <div class="browserName">
                    <img src="images/firefox.png">
                    <p>FireFox 27+</p>
                    <a class="browserLink"
                       href="https://www.mozilla.org/en-US/firefox/new/"><%= i18n.console_term_download_label %></a>
                </div>
            </li>
        </ul>
    </div>
    <div class="cloud">
        <img src="images/left_cloud.png"/>
        <img src="images/right_cloud.png" class="rightCloud" />
    </div>
</div>

<div id="footer">
    <div class="widthLimit">
        <span id="copyright" class="links"><%= i18n.console_term_copyright_label %></span>
        <span id="laws">
            <a class="links" target="_blank" href="http://www.hwclouds.com/declaration/statement.html"><%= i18n.console_term_lawyerInCharge_label %></a>
            <span >|</span>
            <a class="links" target="_blank" href="http://www.hwclouds.com/declaration/sa_prp.html"><%= i18n.console_term_privacyProtect_label %></a>
            <span >|</span>
            <a class="links" target="_blank" href="http://www.hwclouds.com/declaration/sa_cua.html"><%= i18n.console_term_legalAgreement_label %></a>
            <span>|</span>
            <a class="links" target="_blank" href="http://www.hwclouds.com/declaration/sa_nisr.html"><%= i18n.console_term_networkAccess_label %></a>
        </span>
    </div>
</div>